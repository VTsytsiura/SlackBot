{
  "family": "slack-contract-bot",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "slack-contract-bot",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/slack-contract-bot:latest",
      "essential": true,
      "stopTimeout": 30,
      "linuxParameters": { "initProcessEnabled": true },
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "SF_AGENT_LOGIN_URL", "value": "https://<MY_DOMAIN>.my.salesforce.com" },
        { "name": "OPENAI_MODEL", "value": "gpt-4o-mini" }
      ],
      "secrets": [
        { "name": "SLACK_BOT_TOKEN", "valueFrom": "<SECRET_ARN>:SLACK_BOT_TOKEN::" },
        { "name": "SLACK_APP_TOKEN", "valueFrom": "<SECRET_ARN>:SLACK_APP_TOKEN::" },
        { "name": "SF_AGENT_CLIENT_ID", "valueFrom": "<SECRET_ARN>:SF_AGENT_CLIENT_ID::" },
        { "name": "SF_AGENT_CLIENT_SECRET", "valueFrom": "<SECRET_ARN>:SF_AGENT_CLIENT_SECRET::" },
        { "name": "SF_AGENT_ID", "valueFrom": "<SECRET_ARN>:SF_AGENT_ID::" },
        { "name": "OPENAI_API_KEY", "valueFrom": "<SECRET_ARN>:OPENAI_API_KEY::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/slack-contract-bot",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
