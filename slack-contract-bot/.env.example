# Slack app credentials (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Salesforce Agentforce / Agent API (Client Credentials Flow)
SF_AGENT_CLIENT_ID=
SF_AGENT_CLIENT_SECRET=
SF_AGENT_ID=
SF_AGENT_LOGIN_URL=

# Optional: used to generate a smarter "working on it..." placeholder message.
# If unset, the bot falls back to a static placeholder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: debug | info | warn | error (default: info).
# "debug" also logs raw Agent API responses, which may contain contract data.
# LOG_LEVEL=info

# Optional: port for the health check HTTP server (default: 3000).
# PORT=3000
